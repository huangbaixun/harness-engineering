#!/bin/bash
# gh 桩：把调用记录到 $GH_LOG，按 $GH_MODE 返回预设响应。离线、确定性。
# 只记命令头与 flag 名，跳过 --body 的值（多行内容会污染日志）
{ _log=""; _skip=0
  for _a in "$@"; do
    if [ "$_skip" = "1" ]; then _skip=0; _log="$_log <BODY>"; printf '%s\n' "$_a" >> "${GH_BODY_LOG:-/dev/null}"; continue; fi
    case "$_a" in --body) _skip=1; _log="$_log --body";; *) _log="$_log $_a";; esac
  done
  echo "${_log# }"; } >> "${GH_LOG:-/dev/null}"
case "$1 $2" in
  "label list")
      cat "${GH_LABELS_JSON:-/dev/null}" 2>/dev/null || echo '[]' ;;
  "issue list")
      # 真实 gh 的 --label 是精确匹配。桩必须照做，否则会掩盖「用裸前缀过滤」这类 bug。
      _lbl=""; _prev=""
      for _a in "$@"; do [ "$_prev" = "--label" ] && _lbl="$_a"; _prev="$_a"; done
      if [ -n "$_lbl" ]; then
        python3 -c "
import json,sys
try: d=json.load(open(sys.argv[1]))
except Exception: d=[]
want=sys.argv[2]
print(json.dumps([i for i in d if any((l.get('name')=='' or l.get('name'))==want for l in (i.get('labels') or []))]))
" "${GH_ISSUES_JSON:-/dev/null}" "$_lbl" 2>/dev/null || echo '[]'
      else
        cat "${GH_ISSUES_JSON:-/dev/null}" 2>/dev/null || echo '[]'
      fi ;;
  "issue edit"|"issue create"|"label create")
      case "${GH_MODE:-ok}" in
        offline) echo "error connecting to host" >&2; exit 1 ;;
        auth)    echo "HTTP 401: Bad credentials" >&2; exit 1 ;;
        ratelimit) echo "HTTP 403: API rate limit exceeded" >&2; exit 1 ;;
        notfound)  echo "HTTP 404: Not Found" >&2; exit 1 ;;
        *) echo "https://example.com/o/r/issues/999" ;;
      esac ;;
  *) echo "{}" ;;
esac
