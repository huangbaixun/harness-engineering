#!/bin/bash
# init.sh — Harness 会话启动脚本
# 每次开始新的 AI 会话前运行：bash init.sh
# 生成自：harness-engineering plugin / harness:init Skill

set -euo pipefail

PROJECT_NAME="{{PROJECT_NAME}}"
PROGRESS_FILE="docs/claude-progress.json"
# ADR-0012: 规范位置为仓库根目录；docs/ 为兼容旧项目的回退
FEATURES_FILE="$( [ -f features.json ] && echo features.json || echo docs/features.json )"

echo "════════════════════════════════════"
echo "  ${PROJECT_NAME} — Harness 就绪检查"
echo "  工具：Claude Code（.claude/）"
echo "════════════════════════════════════"

# 1. 当前进度
if [ -f "$PROGRESS_FILE" ]; then
  echo ""
  echo "📋 当前任务进度："
  python3 - <<'PYEOF'
import json, sys

try:
    with open("docs/claude-progress.json") as f:
        d = json.load(f)
    current = d.get("current_task", "无")
    completed = d.get("completed", [])
    blocked = d.get("blockers", [])
    print(f"  当前任务：{current}")
    print(f"  已完成：{len(completed)} 项 — {', '.join(completed) if completed else '无'}")
    if blocked:
        print(f"  ⚠️  阻塞项：{', '.join(blocked)}")
except Exception as e:
    print(f"  （进度文件读取失败：{e}）")
PYEOF
else
  echo ""
  echo "📋 首次会话，尚无进度记录"
fi

# 2. 待实现特性
if [ -f "$FEATURES_FILE" ]; then
  echo ""
  echo "📌 特性清单："
  python3 - <<'PYEOF'
import json

try:
    import os
    path = "features.json" if os.path.exists("features.json") else "docs/features.json"
    with open(path) as fh:
        data = json.load(fh)
    # schema 2.0: 顶层是对象，特性在 features 键下
    features = data.get("features", data) if isinstance(data, dict) else data
    building = [f for f in features if f.get("status") in ("building", "in_progress")]
    proposed = [f for f in features if f.get("status") in ("proposed", "pending", "ready")]
    done     = [f for f in features if f.get("status") in ("done", "completed")]
    print(f"  building：{len(building)} | proposed：{len(proposed)} | done：{len(done)}")
    for f in building:
        print(f"  → {f.get('id','?')}: {f.get('name','')}")
except Exception as e:
    print(f"  （特性文件读取失败：{e}）")
PYEOF
fi

# 3. 架构文档提示
echo ""
echo "📐 架构文档：docs/architecture.md"
echo "📖 Agent 记忆：CLAUDE.md"
echo ""
echo "════════════════════════════════════"
echo "  Harness 就绪，可以开始会话 ✓"
echo "════════════════════════════════════"
